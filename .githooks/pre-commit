#!/bin/sh
# Blocks commits that touch _data/publications.yaml unless every
# La-Cava-authored publication has a matching PDF in assets/papers/.
# Installed via: git config core.hooksPath .githooks

if git diff --cached --name-only | grep -q '^_data/publications\.yaml$'; then
  ruby "$(git rev-parse --show-toplevel)/scripts/check_publication_pdfs.rb"
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "Commit blocked: copy the missing PDF(s) into assets/papers/ (filename must"
    echo "match exactly, per Zotero's 'Rename Associated File' convention), then re-stage."
    echo "To bypass once (not recommended): git commit --no-verify"
    exit 1
  fi
fi

exit 0
