#!/bin/sh
# Blocks commits that touch _data/publications.yaml unless every
# La-Cava-authored publication has a matching PDF in assets/papers/.
# Installed via: git config core.hooksPath .githooks

if git diff --cached --name-only | grep -q '^_data/publications\.yaml$'; then
  root="$(git rev-parse --show-toplevel)"
  python3 "$root/scripts/check_publication_pdfs.py"
  status=$?
  if [ $status -ne 0 ]; then
    echo ""
    echo "Attempting to fill gaps from Zotero storage..."
    python3 "$root/scripts/find_missing_pdfs.py" --copy
    echo ""
    echo "Commit blocked. Review any file(s) just copied into assets/papers/ above"
    echo "(delete them if they're the wrong match), resolve anything left missing,"
    echo "then 'git add' the correct PDF(s) and commit again."
    echo "To bypass once (not recommended): git commit --no-verify"
    exit 1
  fi
fi

exit 0
